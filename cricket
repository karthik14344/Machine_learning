        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib\n",
        "matplotlib.use('Agg')\n",
        "import matplotlib.pyplot as plt\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "from scipy.stats import beta as beta_dist, spearmanr\n",
        "from sklearn.linear_model import LinearRegression, LogisticRegression\n",
        "from sklearn.gaussian_process import GaussianProcessRegressor\n",
        "from sklearn.gaussian_process.kernels import RBF, WhiteKernel\n",
        "from sklearn.metrics import mutual_info_score, roc_curve, auc\n",
        "from sklearn.model_selection import LeaveOneOut\n",
        "import statsmodels.api as sm\n",
        "from statsmodels.regression.quantile_regression import QuantReg\n",
        "\n",
        "# =============================================================================\n",
        "# DATA LOADING\n",
        "# =============================================================================\n",
        "deliveries = pd.read_excel('deliveries.xlsx')\n",
        "matches = pd.read_excel('matches.xlsx')\n",
        "points_table = pd.read_excel('points_table.xlsx')\n",
        "\n",
        "# =============================================================================\n",
        "# GROUNDWORK\n",
        "# =============================================================================\n",
        "deliveries['total_runs'] = deliveries['runs_off_bat'] + deliveries['extras']\n",
        "deliveries['over_number'] = np.floor(deliveries['ball']).astype(int)\n",
        "deliveries['is_legal'] = deliveries['wides'].isna() & deliveries['noballs'].isna()\n",
        "\n",
        "def assign_phase(over):\n",
        "    if over <= 9:\n",
        "        return 'Powerplay'\n",
        "    elif over <= 39:\n",
        "        return 'Middle'\n",
        "    else:\n",
        "        return 'Death'\n",
        "\n",
        "deliveries['phase'] = deliveries['over_number'].apply(assign_phase)\n",
        "\n",
        "teams_all = deliveries['batting_team'].unique()\n",
        "\n",
        "batting_stats = deliveries.groupby('batting_team').agg(\n",
        "    total_scored=('total_runs', 'sum'),\n",
        "    legal_balls_faced=('is_legal', 'sum')\n",
        ").reset_index()\n",
        "batting_stats['batting_rr'] = batting_stats['total_scored'] / batting_stats['legal_balls_faced'] * 6\n",
        "batting_stats = batting_stats.rename(columns={'batting_team': 'Team'})\n",
        "\n",
        "bowling_stats = deliveries.groupby('bowling_team').agg(\n",
        "    total_conceded=('total_runs', 'sum'),\n",
        "    legal_balls_bowled=('is_legal', 'sum')\n",
        ").reset_index()\n",
        "bowling_stats['bowling_economy'] = bowling_stats['total_conceded'] / bowling_stats['legal_balls_bowled'] * 6\n",
        "bowling_stats = bowling_stats.rename(columns={'bowling_team': 'Team'})\n",
        "\n",
        "team_data = points_table.merge(batting_stats[['Team', 'batting_rr']], on='Team', how='left')\n",
        "team_data = team_data.merge(bowling_stats[['Team', 'bowling_economy']], on='Team', how='left')\n",
        "\n",
        "# =============================================================================\n",
        "# COMPUTATION 1: Shannon Entropy\n",
        "# =============================================================================\n",
        "over_level = deliveries.groupby(['batting_team', 'match_id', 'innings', 'over_number']).agg(\n",
        "    total_runs_over=('total_runs', 'sum'),\n",
        "    legal_balls_over=('is_legal', 'sum')\n",
        ").reset_index()\n",
        "\n",
        "over_level = over_level[over_level['legal_balls_over'] > 0].copy()\n",
        "over_level['over_run_rate'] = over_level['total_runs_over'] / over_level['legal_balls_over'] * 6\n",
        "\n",
        "global_min = over_level['over_run_rate'].min()\n",
        "global_max = over_level['over_run_rate'].max()\n",
        "bin_edges = np.linspace(global_min, global_max, 11)\n",
        "\n",
        "entropy_dict = {}\n",
        "for team in teams_all:\n",
        "    team_orr = over_level[over_level['batting_team'] == team]['over_run_rate'].values\n",
        "    counts, _ = np.histogram(team_orr, bins=bin_edges)\n",
        "    total_overs = counts.sum()\n",
        "    probs = counts / total_overs\n",
        "    ent = -np.sum(probs[probs > 0] * np.log2(probs[probs > 0]))\n",
        "    entropy_dict[team] = round(ent, 4)\n",
        "\n",
        "max_entropy_val = max(entropy_dict.values())\n",
        "max_entropy_teams = [t for t, e in entropy_dict.items() if e == max_entropy_val]\n",
        "max_entropy_teams.sort()\n",
        "max_entropy_team = max_entropy_teams[0]\n",
        "\n",
        "print(f\"1. Highest Entropy Team: {max_entropy_team}, Entropy: {max_entropy_val:.4f}\")\n",
        "\n",
        "# =============================================================================\n",
        "# COMPUTATION 2: Monte Carlo Permutation Test\n",
        "# =============================================================================\n",
        "top4_teams = points_table[points_table['Ranking'] <= 4]['Team'].tolist()\n",
        "bottom6_teams = points_table[points_table['Ranking'] > 4]['Team'].tolist()\n",
        "\n",
        "batting_rr_series = team_data.set_index('Team')['batting_rr']\n",
        "\n",
        "top4_rr = batting_rr_series[top4_teams].values\n",
        "bottom6_rr = batting_rr_series[bottom6_teams].values\n",
        "observed_diff = top4_rr.mean() - bottom6_rr.mean()\n",
        "\n",
        "all_rr = batting_rr_series.values.copy()\n",
        "np.random.seed(42)\n",
        "n_perm = 10000\n",
        "count_ge = 0\n",
        "for _ in range(n_perm):\n",
        "    perm = np.random.permutation(all_rr)\n",
        "    sim_diff = perm[:4].mean() - perm[4:].mean()\n",
        "    if sim_diff >= observed_diff:\n",
        "        count_ge += 1\n",
        "\n",
        "p_value_mc = round(count_ge / n_perm, 4)\n",
        "print(f\"2. Monte Carlo p-value: {p_value_mc:.4f}\")\n",
        "\n",
        "# =============================================================================\n",
        "# COMPUTATION 3: Quantile Regression - Death Coefficient\n",
        "# =============================================================================\n",
        "over_level_qr = over_level.copy()\n",
        "over_level_qr['Middle'] = (over_level_qr['over_number'].apply(assign_phase) == 'Middle').astype(int)\n",
        "over_level_qr['Death'] = (over_level_qr['over_number'].apply(assign_phase) == 'Death').astype(int)\n",
        "\n",
        "innings_col = over_level_qr['innings'].values\n",
        "X_qr = over_level_qr[['Middle', 'Death']].copy()\n",
        "X_qr['innings'] = innings_col\n",
        "X_qr = sm.add_constant(X_qr)\n",
        "y_qr = over_level_qr['over_run_rate'].values\n",
        "\n",
        "model_qr = QuantReg(y_qr, X_qr)\n",
        "result_qr = model_qr.fit(q=0.5, max_iter=1000)\n",
        "death_coeff = round(result_qr.params['Death'], 4)\n",
        "print(f\"3. Quantile Regression Death Coefficient: {death_coeff:.4f}\")\n",
        "\n",
        "# =============================================================================\n",
        "# COMPUTATION 4: Mutual Information\n",
        "# =============================================================================\n",
        "mi_data = team_data[['Team', 'batting_rr', 'Points']].copy()\n",
        "mi_data['batting_rr_bin'] = pd.qcut(mi_data['batting_rr'], q=3, labels=[0, 1, 2])\n",
        "mi_data['points_bin'] = pd.qcut(mi_data['Points'], q=3, labels=[0, 1, 2])\n",
        "\n",
        "mi_value = round(mutual_info_score(mi_data['batting_rr_bin'].astype(int),\n",
        "                                    mi_data['points_bin'].astype(int)), 4)\n",
        "print(f\"4. Mutual Information: {mi_value:.4f}\")\n",
        "\n",
        "# =============================================================================\n",
        "# COMPUTATION 5: Bayesian Toss Analysis\n",
        "# =============================================================================\n",
        "matches_valid = matches.dropna(subset=['winner'])\n",
        "successes = (matches_valid['toss_winner'] == matches_valid['winner']).sum()\n",
        "failures = (matches_valid['toss_winner'] != matches_valid['winner']).sum()\n",
        "\n",
        "posterior_prob = round(beta_dist.sf(0.5, 1 + successes, 1 + failures), 4)\n",
        "print(f\"5. Bayesian Toss P(win_rate > 0.5): {posterior_prob:.4f}\")\n",
        "\n",
        "# =============================================================================\n",
        "# COMPUTATION 6: Conformal Prediction Interval\n",
        "# =============================================================================\n",
        "X_conf = team_data[['batting_rr', 'bowling_economy']].values\n",
        "y_conf = team_data['Points'].values\n",
        "\n",
        "lr_conf = LinearRegression()\n",
        "lr_conf.fit(X_conf, y_conf)\n",
        "y_pred_conf = lr_conf.predict(X_conf)\n",
        "abs_residuals = np.abs(y_conf - y_pred_conf)\n",
        "conformal_hw = round(np.percentile(abs_residuals, 90, interpolation='higher'), 4)\n",
        "print(f\"6. Conformal 90% Half-Width: {conformal_hw:.4f}\")\n",
        "\n",
        "# =============================================================================\n",
        "# COMPUTATION 7: Markov Chain Dot-to-Dot\n",
        "# =============================================================================\n",
        "def label_run(r):\n",
        "    if r == 0:\n",
        "        return 'Dot'\n",
        "    elif r <= 2:\n",
        "        return 'Low'\n",
        "    elif r <= 4:\n",
        "        return 'Medium'\n",
        "    else:\n",
        "        return 'High'\n",
        "\n",
        "deliveries['run_state'] = deliveries['total_runs'].apply(label_run)\n",
        "\n",
        "states_order = ['Dot', 'Low', 'Medium', 'High']\n",
        "state_idx = {s: i for i, s in enumerate(states_order)}\n",
        "trans_counts = np.zeros((4, 4))\n",
        "\n",
        "for (mid, inn), grp in deliveries.groupby(['match_id', 'innings']):\n",
        "    seq = grp['run_state'].values\n",
        "    for i in range(len(seq) - 1):\n",
        "        fr = state_idx[seq[i]]\n",
        "        to = state_idx[seq[i + 1]]\n",
        "        trans_counts[fr, to] += 1\n",
        "\n",
        "row_sums = trans_counts.sum(axis=1, keepdims=True)\n",
        "trans_probs = trans_counts / row_sums\n",
        "dot_to_dot = trans_probs[0, 0]\n",
        "print(f\"7. Dot-to-Dot Transition Probability: {dot_to_dot:.4f}\")\n",
        "\n",
        "# =============================================================================\n",
        "# COMPUTATION 8: Gaussian Process MAE\n",
        "# =============================================================================\n",
        "X_gp = team_data[['batting_rr', 'bowling_economy']].values\n",
        "y_gp = team_data['Net Run Rate'].values\n",
        "\n",
        "kernel = RBF(length_scale=1.0) + WhiteKernel(noise_level=0.1)\n",
        "gpr = GaussianProcessRegressor(kernel=kernel, random_state=42, alpha=1e-10,\n",
        "                                n_restarts_optimizer=5)\n",
        "gpr.fit(X_gp, y_gp)\n",
        "y_gp_pred = gpr.predict(X_gp)\n",
        "gp_mae = round(np.mean(np.abs(y_gp - y_gp_pred)), 4)\n",
        "print(f\"8. GP MAE: {gp_mae:.4f}\")\n",
        "\n",
        "# =============================================================================\n",
        "# Add entropy to team_data for plots\n",
        "# =============================================================================\n",
        "team_data['entropy'] = team_data['Team'].map(entropy_dict)\n",
        "\n",
        "# =============================================================================\n",
        "# PLOT 1: Spearman Correlation Heatmap\n",
        "# =============================================================================\n",
        "plot_vars = team_data[['batting_rr', 'bowling_economy', 'entropy', 'Points',\n",
        "                        'Net Run Rate', 'Won']].values\n",
        "var_labels = ['Bat RR', 'Bowl Econ', 'Entropy', 'Points', 'NRR', 'Wins']\n",
        "n_vars = len(var_labels)\n",
        "\n",
        "spearman_matrix = np.zeros((n_vars, n_vars))\n",
        "for i in range(n_vars):\n",
        "    for j in range(n_vars):\n",
        "        corr, _ = spearmanr(plot_vars[:, i], plot_vars[:, j])\n",
        "        spearman_matrix[i, j] = corr\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(8, 6))\n",
        "im = ax.imshow(spearman_matrix, cmap='RdBu_r', vmin=-1, vmax=1)\n",
        "ax.set_xticks(range(n_vars))\n",
        "ax.set_yticks(range(n_vars))\n",
        "ax.set_xticklabels(var_labels)\n",
        "ax.set_yticklabels(var_labels)\n",
        "for i in range(n_vars):\n",
        "    for j in range(n_vars):\n",
        "        ax.text(j, i, f\"{spearman_matrix[i, j]:.2f}\", ha='center', va='center',\n",
        "                color='black', fontsize=9)\n",
        "plt.colorbar(im, ax=ax)\n",
        "ax.set_title(\"Team-Level Spearman Correlation Heatmap\")\n",
        "plt.tight_layout()\n",
        "plt.savefig('plot1_spearman_heatmap.png', dpi=150)\n",
        "plt.close()\n",
        "print(\"Plot 1 saved: plot1_spearman_heatmap.png\")\n",
        "\n",
        "# =============================================================================\n",
        "# PLOT 2: Scatter of batting_rr vs NRR with GP Fit\n",
        "# =============================================================================\n",
        "fig, ax = plt.subplots(figsize=(8, 6))\n",
        "ax.scatter(team_data['batting_rr'], team_data['Net Run Rate'], zorder=5)\n",
        "for _, row in team_data.iterrows():\n",
        "    ax.annotate(row['Team'], (row['batting_rr'], row['Net Run Rate']),\n",
        "                textcoords=\"offset points\", xytext=(5, 5), fontsize=8)\n",
        "\n",
        "mean_bowl_econ = team_data['bowling_economy'].mean()\n",
        "brr_range = np.linspace(team_data['batting_rr'].min(), team_data['batting_rr'].max(), 100)\n",
        "X_gp_line = np.column_stack([brr_range, np.full(100, mean_bowl_econ)])\n",
        "y_gp_line = gpr.predict(X_gp_line)\n",
        "ax.plot(brr_range, y_gp_line, color='green', linewidth=2, label='GP Mean Prediction')\n",
        "\n",
        "ax.set_xlabel(\"Batting Run Rate\")\n",
        "ax.set_ylabel(\"Net Run Rate\")\n",
        "ax.set_title(\"Team Batting Run Rate vs Net Run Rate with GP Fit\")\n",
        "ax.legend()\n",
        "plt.tight_layout()\n",
        "plt.savefig('plot2_batting_rr_vs_nrr_gp.png', dpi=150)\n",
        "plt.close()\n",
        "print(\"Plot 2 saved: plot2_batting_rr_vs_nrr_gp.png\")\n",
        "\n",
        "# =============================================================================\n",
        "# PLOT 3: CUSUM Chart for Match 48 Innings 1\n",
        "# =============================================================================\n",
        "m48_i1 = over_level[(over_level['match_id'] == 48) & (over_level['innings'] == 1)].copy()\n",
        "m48_i1 = m48_i1.sort_values('over_number')\n",
        "mu = m48_i1['over_run_rate'].mean()\n",
        "m48_i1['cusum'] = (m48_i1['over_run_rate'] - mu).cumsum()\n",
        "\n",
        "wicket_overs_df = deliveries[(deliveries['match_id'] == 48) & (deliveries['innings'] == 1) &\n",
        "                              deliveries['wicket_type'].notna()]\n",
        "wicket_overs = wicket_overs_df['over_number'].unique()\n",
        "\n",
        "max_abs_idx = m48_i1['cusum'].abs().idxmax()\n",
        "max_shift_over = m48_i1.loc[max_abs_idx, 'over_number']\n",
        "max_shift_cusum = m48_i1.loc[max_abs_idx, 'cusum']\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(10, 5))\n",
        "ax.plot(m48_i1['over_number'], m48_i1['cusum'], color='darkblue', linewidth=2, label='CUSUM')\n",
        "for wo in wicket_overs:\n",
        "    ax.axvline(x=wo, color='red', linestyle='--', alpha=0.7,\n",
        "               label='Wicket Over' if wo == wicket_overs[0] else '')\n",
        "ax.axhline(y=0, color='gray', linestyle='--', alpha=0.7)\n",
        "ax.plot(max_shift_over, max_shift_cusum, marker='D', color='red', markersize=10,\n",
        "        zorder=5, label='Max Shift')\n",
        "ax.set_xlabel(\"Over Number\")\n",
        "ax.set_ylabel(\"CUSUM of Run Rate Deviation\")\n",
        "ax.set_title(\"CUSUM Chart: Match 48, Innings 1\")\n",
        "ax.legend()\n",
        "plt.tight_layout()\n",
        "plt.savefig('plot3_cusum_match48.png', dpi=150)\n",
        "plt.close()\n",
        "print(\"Plot 3 saved: plot3_cusum_match48.png\")\n",
        "\n",
        "# =============================================================================\n",
        "# PLOT 4: Bump Chart - Team Ranking Progression\n",
        "# =============================================================================\n",
        "all_teams_sorted = sorted(points_table['Team'].tolist())\n",
        "color_map = {t: plt.cm.tab10(i) for i, t in enumerate(all_teams_sorted)}\n",
        "\n",
        "match_numbers = sorted(matches['match_number'].unique())\n",
        "cum_points = {t: 0 for t in all_teams_sorted}\n",
        "ranking_history = {t: [] for t in all_teams_sorted}\n",
        "match_num_list = []\n",
        "\n",
        "for mn in match_numbers:\n",
        "    match_row = matches[matches['match_number'] == mn].iloc[0]\n",
        "    winner = match_row['winner']\n",
        "    if pd.notna(winner):\n",
        "        cum_points[winner] += 2\n",
        "\n",
        "    pts_list = [(t, cum_points[t]) for t in all_teams_sorted]\n",
        "    pts_list.sort(key=lambda x: (-x[1], x[0]))\n",
        "    for rank, (t, _) in enumerate(pts_list, 1):\n",
        "        ranking_history[t].append(rank)\n",
        "    match_num_list.append(mn)\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(14, 7))\n",
        "for team in all_teams_sorted:\n",
        "    ax.plot(match_num_list, ranking_history[team], color=color_map[team],\n",
        "            linewidth=2, label=team, marker='o', markersize=3)\n",
        "ax.invert_yaxis()\n",
        "ax.set_xlabel(\"Match Number\")\n",
        "ax.set_ylabel(\"Rank Position\")\n",
        "ax.set_title(\"Team Ranking Progression Across the Tournament\")\n",
